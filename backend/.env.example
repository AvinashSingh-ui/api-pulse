# =============================================================================
# API PULSE BACKEND CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# Server & Network Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
API_BASE_URL=http://localhost:8000/api/v1

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database & AI Services
DATABASE_URL=postgresql://postgres:password@localhost:5432/apipulse
GEMINI_API_KEY=

# Background Monitoring Service
MONITORING_INTERVAL_DEFAULT=60

# Backend API Routes
API_AUTH_ROUTE=/api/v1/auth
API_PROJECTS_ROUTE=/api/v1/projects
API_ENDPOINTS_ROUTE=/api/v1/endpoints
API_MONITORING_ROUTE=/api/v1/monitoring
API_LOGS_ROUTE=/api/v1/logs
API_ALERTS_ROUTE=/api/v1/alerts
API_AI_ROUTE=/api/v1/ai
API_TESTING_ROUTE=/api/v1/testing
API_OPENAPI_ROUTE=/api/v1/openapi
API_NOTIFICATIONS_ROUTE=/api/v1/notifications
