# =============================================================================
# API PULSE FRONTEND CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# Main Backend API Base URL
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000

# Application Information
VITE_APP_NAME="API Pulse"
VITE_APP_VERSION="1.0.0"

# Specific API Endpoints
VITE_API_AUTH_URL=/auth
VITE_API_PROJECTS_URL=/projects
VITE_API_ENDPOINTS_URL=/endpoints
VITE_API_MONITORING_URL=/monitoring
VITE_API_LOGS_URL=/logs
VITE_API_ALERTS_URL=/alerts
VITE_API_AI_URL=/ai
VITE_API_TESTING_URL=/testing
VITE_API_OPENAPI_URL=/openapi
VITE_API_NOTIFICATIONS_URL=/notifications
